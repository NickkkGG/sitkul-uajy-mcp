# Credentials stay only on the computer that runs this MCP server. Never commit .env.
SITKUL_USERNAME=your_student_number
SITKUL_PASSWORD=your_password

# Optional. Defaults to the official UAJY LMS.
SITKUL_BASE_URL=https://kuliah.uajy.ac.id

# Folder used by download_material. Defaults to ./downloads.
SITKUL_DOWNLOAD_DIR=./downloads

# Optional Canva OAuth for download_canva_material. Create a personal Canva
# developer app, register the redirect URL exactly, then keep these values local.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:3434/canva/oauth/callback
# Generate once locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CANVA_TOKEN_ENCRYPTION_KEY=
# Optional. Defaults to %LOCALAPPDATA%\\SitkulUajyMcp\\canva-oauth.enc.
CANVA_TOKEN_STORE_PATH=
