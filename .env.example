# Credentials stay only on the computer that runs this MCP server. Never commit .env.
SITKUL_USERNAME=your_student_number
SITKUL_PASSWORD=your_password

# Optional. Defaults to the official UAJY LMS.
SITKUL_BASE_URL=https://kuliah.uajy.ac.id

# Folder used by download_material. Defaults to ./downloads.
SITKUL_DOWNLOAD_DIR=./downloads
